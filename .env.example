# Site (optional — used for metadataBase / sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# TMDB — prefer server-only key; v4 read token is most secure
TMDB_API_KEY=
TMDB_API_READ_TOKEN=
TMDB_API_BASE=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# Legacy (avoid in production — use TMDB_API_KEY instead)
# NEXT_PUBLIC_TMDB_API_KEY=

# Cache TTL (seconds) — raise on Vercel Hobby to cut serverless usage (default 86400 = 24h)
CACHE_REVALIDATE_SECONDS=86400
SEARCH_CACHE_SECONDS=3600

# PostgreSQL (optional — only checked when ENABLE_DB_HEALTH=true)
DATABASE_URL=
ENABLE_DB_HEALTH=false
